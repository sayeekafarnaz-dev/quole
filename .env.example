NODE_ENV=development
HOST=127.0.0.1
PORT=4310
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Required in production. Site key is public; secret stays server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Must be exact origins. Each origin may access only its mapped context.
QUOLE_ORIGINS={"https://qlogue.com":"qlogue","https://www.qlogue.com":"qlogue","https://adubio.ai":"adubio","https://www.adubio.ai":"adubio","https://pruque.com":"pruque","https://www.pruque.com":"pruque"}
# Fill only after approval of processor/privacy terms and original character.
QUOLE_PUBLIC_READY=false
QUOLE_ASSET_URL=
QUOLE_PRIVACY_URL=
# Single process only; do not trust forwarded IP headers.
QUOLE_REQUESTS_PER_MINUTE=10
QUOLE_DAILY_REQUESTS=500
# Optional approved stylesheet hosting DM Sans + DM Serif Display @font-face rules.
# Fonts are not sent conversation contents. Self-host rather than use tracking services.
QUOLE_FONT_CSS_URL=
